<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>HawkEye — Single Page Ops Dashboard (SPA)</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- styles -->
  <link rel="stylesheet" href="style.css">

  <!--  JS  -->
    <script defer src="app.js"></script>

</head>
<body>


  <!-- MAIN -->
  <main class="main">

   <!-- Sidebar Navigation -->
   <nav id="sidebar-nav" style="position:fixed; left:20px; top:20px; width:220px; background:linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02)); border:1px solid rgba(255,255,255,0.06); border-radius:16px; padding:16px; box-shadow:0 8px 24px rgba(2,6,23,0.6); z-index:100">
     <div style="margin-bottom:20px; padding-bottom:12px; border-bottom:1px solid rgba(255,255,255,0.08)">
       <h2 style="margin:0; font-size:20px; color:var(--accent-2)">
         <i class="fas fa-eye" style="margin-right:8px"></i>HawkEye
       </h2>
       <p class="muted" style="margin:4px 0 0; font-size:11px">Drone Ops Center</p>
     </div>
     <a href="#dashboard" data-view="dashboard" style="display:flex; align-items:center; gap:10px; padding:10px; border-radius:8px; color:inherit; text-decoration:none; margin-bottom:4px; transition:all 0.2s">
       <i class="fas fa-th-large" style="width:20px; text-align:center"></i>
       <span>Dashboard</span>
     </a>
     <a href="#mission" data-view="mission" style="display:flex; align-items:center; gap:10px; padding:10px; border-radius:8px; color:inherit; text-decoration:none; margin-bottom:4px; transition:all 0.2s">
       <i class="fas fa-route" style="width:20px; text-align:center"></i>
       <span>Mission Planner</span>
     </a>
     <a href="#live" data-view="live" style="display:flex; align-items:center; gap:10px; padding:10px; border-radius:8px; color:inherit; text-decoration:none; margin-bottom:4px; transition:all 0.2s">
       <i class="fas fa-video" style="width:20px; text-align:center"></i>
       <span>Live Feed</span>
     </a>
     <a href="#simulator" data-view="simulator" style="display:flex; align-items:center; gap:10px; padding:10px; border-radius:8px; color:inherit; text-decoration:none; margin-bottom:4px; transition:all 0.2s; background:rgba(30,144,255,0.1); border:1px solid rgba(30,144,255,0.3)">
       <i class="fas fa-cloud-upload-alt" style="width:20px; text-align:center; color:var(--accent-2)"></i>
       <span style="font-weight:600; color:var(--accent-2)">Drone Simulator</span>
     </a>
     <a href="#telemetry" data-view="telemetry" style="display:flex; align-items:center; gap:10px; padding:10px; border-radius:8px; color:inherit; text-decoration:none; margin-bottom:4px; transition:all 0.2s">
       <i class="fas fa-table" style="width:20px; text-align:center"></i>
       <span>Telemetry</span>
     </a>
   </nav>

   <header style="display:flex; justify-content:space-between; align-items:center; padding:14px 18px; border-radius:12px; background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); border:1px solid rgba(255,255,255,0.03); box-shadow:0 8px 20px rgba(2,6,23,0.5); margin-left:260px">

    <!-- Left side -->
    <div class="left">
      <h1 id="page-title" style="margin:0; font-size:18px">HawkEye Drone Dashboard</h1>
      <div class="sub" id="page-sub" style="font-size:12px; color:var(--muted)">Operational Center — Live monitoring • Playback • Exports</div>
    </div>

    <!-- Right side: notifications + home button + settings + role -->
    <div class="header-right" style="display:flex; align-items:center; gap:12px">

      <!-- Notification pill -->
      <div class="user-pill" title="Notifications" id="notif-pill"
           style="display:flex; align-items:center; gap:4px; cursor:pointer">
        <i class="fas fa-bell" style="color:var(--accent-2);"></i>
        <span id="badge-count" class="badge" style="display:none">0</span>
      </div>

      <!-- Home button -->
      <div class="user-pill" title="Home" id="home-btn"
           style="display:flex; align-items:center; gap:4px; cursor:pointer; padding:6px 10px;">
        <i class="fas fa-home" style="color:var(--accent-2);"></i>
      </div>

      <!-- Settings icon (will be hidden when viewing settings) -->
      <div id="header-settings" title="Settings" style="cursor:pointer; padding:6px">
        <i class="fas fa-cog" style="color:var(--muted); font-size:18px;"></i>
      </div>
     

      <div id="user-role-display" class="muted" style="font-size:12px">user · role</div>
    </div>

   </header>


    <div style="margin-left:260px">
    <!-- Dashboard view -->
    <section id="view-dashboard" class="view">
  <section class="cards">
    <div class="card">
      <div class="title">Battery</div>
      <div class="value" id="battery">--%</div>
      <div class="meta">HawkEye • Remaining</div>
    </div>
    <div class="card">
      <div class="title">Altitude</div>
      <div class="value" id="altitude">-- m</div>
      <div class="meta">Above ground level</div>
    </div>
    <div class="card">
      <div class="title">Speed</div>
      <div class="value" id="speed">-- km/h</div>
      <div class="meta">Ground speed</div>
    </div>
    <div class="card">
      <div class="title">GPS</div>
      <div class="value" id="gps">--</div>
      <div class="meta">Satellite lock</div>
    </div>
  </section>
</section>
 <section class="mission-wrap" style="display:flex; gap:16px; flex-wrap:wrap">
        <div class="col" style="flex:1.6">

   <div class="panel">
  <h3>HawkEye Live Drone Camera</h3>
  <div class="video-wrap" style="width:100%; height:300px; position:relative;">
    <video id="live-drone-video" autoplay muted playsinline style="width:100%; height:100%; object-fit:cover;">
      <source src="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4" type="video/mp4">
      Your browser does not support HTML5 video.
    </video>
    <canvas id="overlay-drone" class="overlay-canvas"></canvas>
  </div>
  <div class="muted" style="margin-top:8px">Live drone camera feed • simulated</div>
</div>

          <div class="panel">
            <h3>HawkEye Live Map</h3>
            <div id="map-dashboard" class="map"></div>
            <div class="muted" style="margin-top:8px">Live GPS track & flight path • simulated</div>
          </div>


          <div class="panel">
            <h3>Telemetry Logs</h3>
            <div class="search-row" style="margin-bottom:10px">
              <label class="muted">From (s): <input type="number" id="filter-from" placeholder="0" min="0"></label>
              <label class="muted">To (s): <input type="number" id="filter-to" placeholder="9999" min="0"></label>
              <label class="muted">Label:
                <select id="filter-label" style="min-width:120px"><option value="">— any —</option></select>
              </label>
              <button id="apply-filter" class="btn takeoff">Apply</button>
              <button id="clear-filter" class="btn land">Clear</button>
            </div>

            <table id="telemetry-table">
              <thead><tr><th>Time</th><th>Lat</th><th>Lng</th><th>Alt</th><th>Speed</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

        
        <div class="col" style="flex:1.3">
          <div class="panel">
            <h3>Recorded Footage & AI Detection</h3>
            <div class="video-wrap" id="video-panel">
              <video id="playback" crossorigin="anonymous" preload="metadata" controls>
                <source src="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4" type="video/mp4">
                Your browser does not support HTML5 video.
              </video>
              <canvas id="overlay" class="overlay-canvas"></canvas>
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:10px;gap:8px">
              <div class="controls" id="playback-controls">
                <button id="play-btn" class="btn takeoff">Play</button>
                <button id="pause-btn" class="btn land">Pause</button>
                <button id="rewind-btn" class="btn return"><< 5s</button>
                <button id="forward-btn" class="btn hover">5s >></button>
              </div>

              <div style="display:flex;gap:8px;align-items:center">
                <label class="muted">Clip (s): <input id="clip-duration" type="number" min="1" value="6" style="width:70px"></label>
                <button id="export-clip-btn" class="btn return rbac-export">Export Clip</button>
                <button id="export-report-btn" class="btn takeoff rbac-export">Export Report</button>
              </div>
            </div>

            <div class="detections-list" id="detections-list" aria-live="polite" style="margin-top:10px"></div>
          </div>

          <div class="panel">
            <h3>Live Mission Controls</h3>
            <div class="muted" style="margin-bottom:8px">Trigger commands for HawkEye — role controlled</div>
            <div class="controls" id="mission-controls">
              <button class="btn takeoff rbac-control" id="btn-takeoff">Takeoff</button>
              <button class="btn land rbac-control" id="btn-land">Land</button>
              <button class="btn return rbac-control" id="btn-return">Return Home</button>
              <button class="btn hover rbac-control" id="btn-hover">Hover</button>
            </div>

            <div style="margin-top:12px">
              <h4 style="margin:6px 0">Alerts</h4>
              <div class="alerts" id="alerts-pane"></div>
            </div>
          </div>
        </div>
      </section>
    </section>

    <!-- Mission Planner view -->
    <section id="view-mission" class="view" style="display:none">
      <div class="panel">
        <h3>Mission Planner</h3>
        <div id="map-mission" class="map" style="height:420px"></div>
        <div style="margin-top:10px; display:flex; gap:8px; align-items:center;">
          <button id="clear-waypoints" class="btn land">Clear Waypoints</button>
          <button id="export-mission" class="btn takeoff rbac-export">Export Mission</button>
          <div class="muted" style="margin-left:auto">Click on the map to add waypoint</div>
        </div>
        <table style="margin-top:10px">
          <thead><tr><th>#</th><th>Lat</th><th>Lng</th><th>Actions</th></tr></thead>
          <tbody id="waypoints-list"></tbody>
        </table>
      </div>
    </section>

    <!-- Live Feed view -->
    <section id="view-live" class="view" style="display:none">
      <div class="panel">
        <h3>Live Video Feed</h3>
        <div class="video-wrap">
          <video id="live-video" class="live-video" controls autoplay muted style="height:430px">
            <source src="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4" type="video/mp4">
          </video>
          <canvas id="overlay-live" class="overlay-canvas"></canvas>
        </div>
      </div>
      <div class="panel">
        <h3>Live Alerts</h3>
        <div id="live-alerts" class="alerts"></div>
      </div>
    </section>

    <!-- Drone Simulator view (Video Upload) -->
    <section id="view-simulator" class="view" style="display:none">
      <div class="panel">
        <h3>Drone Feed Simulator</h3>
        <p class="muted" style="margin-bottom:16px">Upload a video file to simulate drone camera feed. The system will process it in real-time with AI detection.</p>

        <div style="display:flex; flex-direction:column; gap:16px; max-width:600px">
          <!-- File upload area -->
          <div id="upload-area" style="border:2px dashed rgba(255,255,255,0.2); border-radius:12px; padding:32px; text-align:center; cursor:pointer; transition:all 0.3s">
            <i class="fas fa-cloud-upload-alt" style="font-size:48px; color:var(--accent-2); margin-bottom:12px"></i>
            <p style="margin:8px 0; font-size:16px">Click to upload or drag & drop</p>
            <p class="muted" style="font-size:13px">Supported formats: MP4, AVI, MOV (max 100MB)</p>
            <input type="file" id="video-upload-input" accept="video/*" style="display:none">
          </div>

          <!-- Upload progress -->
          <div id="upload-progress" style="display:none">
            <div style="display:flex; justify-content:space-between; margin-bottom:8px">
              <span id="upload-filename">Uploading...</span>
              <span id="upload-percent">0%</span>
            </div>
            <div style="width:100%; height:8px; background:rgba(255,255,255,0.1); border-radius:4px; overflow:hidden">
              <div id="upload-bar" style="width:0%; height:100%; background:var(--accent-2); transition:width 0.3s"></div>
            </div>
          </div>

          <!-- Upload status -->
          <div id="upload-status" style="display:none; padding:12px; border-radius:8px; background:rgba(0,255,0,0.1); border:1px solid rgba(0,255,0,0.2)">
            <i class="fas fa-check-circle" style="color:#0f0"></i>
            <span id="upload-message" style="margin-left:8px">Video uploaded successfully!</span>
          </div>

          <!-- Video preview and controls -->
          <div id="simulator-preview" style="display:none">
            <h4 style="margin-bottom:8px">Live Simulation Feed</h4>
            <div class="video-wrap" style="width:100%; height:400px; position:relative">
              <img id="simulator-frame" src="" style="width:100%; height:100%; object-fit:contain; background:#000">
              <canvas id="overlay-simulator" class="overlay-canvas"></canvas>
            </div>

            <div style="display:flex; gap:8px; margin-top:12px; align-items:center">
              <span class="muted">Frame: <span id="sim-frame-num">0</span> / <span id="sim-total-frames">0</span></span>
              <span class="muted" style="margin-left:auto">Detections: <span id="sim-detection-count" style="color:var(--accent-2); font-weight:bold">0</span></span>
            </div>

            <!-- Detection details -->
            <div id="sim-detections-list" style="margin-top:12px; max-height:200px; overflow-y:auto"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Telemetry view -->
    <section id="view-telemetry" class="view" style="display:none">
      <div class="panel">
        <h3>Telemetry Logs — Full View</h3>
        <div style="display:flex;gap:8px;margin-bottom:10px;align-items:center">
          <input id="telemetry-search" placeholder="Search label or time..." style="flex:1;padding:8px;border-radius:8px;background:transparent;border:1px solid rgba(255,255,255,0.04);color:inherit">
          <button id="export-csv-telemetry" class="btn takeoff rbac-export">Export CSV</button>
        </div>
        <table id="telemetry-full">
          <thead><tr><th>Time</th><th>Label</th><th>Lat</th><th>Lng</th><th>Alt</th><th>Speed</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </section>



<section id="view-settings" class="view" style="display:none">

  <!-- Users & Roles Panel -->
  <div id="users-table-section" class="settings-section">
    <h3>Settings — Users & Roles</h3>
    <table>
      <thead>
        <tr><th>Username</th><th>Role</th><th>Actions</th></tr>
      </thead>
      <tbody id="users-table"></tbody>
    </table>
  </div>

  <!-- System Settings Panel -->
  <div id="system-settings-section" class="settings-section">
    <h3>System Settings</h3>
    <div style="display:flex; gap:8px; align-items:center;">
      <button id="reset-data" class="btn land">Reset Simulated Data</button>
      <span class="muted" style="margin-left:auto">Settings are simulated (demo)</span>
    </div>
  </div>

</section>
    </div>

<div class="footer-note" style="margin-left:260px">HawkEye • Designer Ops — Demo SPA with simulated detection & export features</div>



  <!-- Small local navigation helper (safe, won't override your app.js showView if present) -->
  <script>
    // Helper that either uses existing showView (SPA) or falls back to classic navigation
    function goToView(viewId){
      if (typeof showView === 'function') {
        // use app's router function if exists
        showView(viewId);
      } else {
        // fallback: show/hide views manually
        document.querySelectorAll('.view').forEach(v => v.style.display = 'none');
        const el = document.getElementById(viewId);
        if (el) el.style.display = 'block';
      }
      // also update header text for common views
      if (viewId === 'view-dashboard') {
        const pt = document.getElementById('page-title');
        const ps = document.getElementById('page-sub');
        if (pt) pt.innerText = 'HawkEye Drone Dashboard';
        if (ps) ps.innerText = 'Operational Center — Live monitoring • Playback • Exports';
        // show settings cog
        const cog = document.getElementById('header-settings');
        if (cog) cog.style.display = '';
      } else if (viewId === 'view-settings') {
        const pt = document.getElementById('page-title');
        const ps = document.getElementById('page-sub');
        if (pt) pt.innerText = 'Settings';
        if (ps) ps.innerText = 'Users, roles & system';
        // hide settings cog while inside settings view
        const cog = document.getElementById('header-settings');
        if (cog) cog.style.display = 'none';
      }
    }

    
    // wire header buttons
    document.getElementById('home-btn')?.addEventListener('click', ()=> goToView('view-dashboard'));
    document.getElementById('header-settings')?.addEventListener('click', ()=> goToView('view-settings'));

    // small safety: show dashboard on load (if no router)
    document.addEventListener('DOMContentLoaded', ()=>{
      // if app.js handles routing, it will override; this ensures a visible view for a plain HTML preview
      if (typeof router !== 'function') {
        goToView('view-dashboard');
      }
    });
  </script>

</body>
</html>
